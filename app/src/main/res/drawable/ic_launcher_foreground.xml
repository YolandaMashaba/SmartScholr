<?xml version="1.0" encoding="utf-8"?>
<!-- Centered app logo; keep key art in the middle 2/3 of the 108dp safe zone for circle/squircle masks -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:width="86dp"
        android:height="86dp"
        android:gravity="center">
        <bitmap
            android:gravity="center"
            android:src="@drawable/splash_logo" />
    </item>
</layer-list>
