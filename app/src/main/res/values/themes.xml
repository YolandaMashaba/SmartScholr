<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Light-only brand theme so the UI matches the Smart Scholr mock (teal / orange / off-white). -->
    <style name="Base.Theme.SmartScholr" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/teal_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/teal_header_end</item>
        <item name="colorOnPrimaryContainer">@color/white</item>
        <item name="colorSecondary">@color/orange_accent</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSecondaryContainer">@color/orange_soft</item>
        <item name="colorOnSecondaryContainer">@color/teal_dark</item>
        <item name="android:colorBackground">@color/card_background</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/teal_dark</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/outline_soft</item>
        <item name="android:statusBarColor">@color/teal_header_start</item>
        <item name="android:navigationBarColor">@color/card_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <style name="Theme.SmartScholr" parent="Base.Theme.SmartScholr" />

    <style name="Theme.SmartScholr.Splash" parent="Theme.SmartScholr">
        <item name="android:statusBarColor">@color/auth_teal</item>
        <item name="android:navigationBarColor">@color/auth_splash_bottom</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <style name="Theme.SmartScholr.Auth" parent="Theme.SmartScholr">
        <item name="android:statusBarColor">@color/auth_screen_bg</item>
        <item name="android:navigationBarColor">@color/auth_screen_bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:colorBackground">@color/auth_screen_bg</item>
        <item name="colorSurface">@color/white</item>
    </style>
</resources>
