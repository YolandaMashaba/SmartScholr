<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Widget.SmartScholr.Auth.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="boxStrokeColor">@color/auth_input_box_stroke</item>
        <item name="hintTextAppearance">@style/TextAppearance.SmartScholr.Auth.Hint</item>
        <item name="counterTextAppearance">@style/TextAppearance.Material3.BodySmall</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearanceOverlay.SmartScholr.Auth.Field</item>
        <item name="android:textColorHint">@color/auth_hint_placeholder</item>
    </style>

    <style name="ShapeAppearanceOverlay.SmartScholr.Auth.Field" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

    <style name="TextAppearance.SmartScholr.Auth.Hint" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/auth_hint_placeholder</item>
    </style>

    <style name="Widget.SmartScholr.Auth.PrimaryButton" parent="Widget.Material3.Button.UnelevatedButton">
        <item name="android:textAppearance">@style/TextAppearance.Material3.TitleMedium</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">@dimen/auth_primary_button_corner_radius</item>
        <item name="backgroundTint">@color/terracotta</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">17sp</item>
        <item name="android:letterSpacing">0.01</item>
    </style>
</resources>
